{
  "version": 1,
  "vacuous_test": {
    "verify_command": [
      "python3",
      "verify.py"
    ],
    "mutations": [
      {
        "name": "strip-status",
        "path": "corpus/doc-1.txt",
        "search": "status: searched",
        "replace": "unknown"
      }
    ]
  },
  "effect_reachability": {
    "endpoint": "a clean verdict is refused when coverage is incomplete",
    "strata": [
      {
        "name": "searched",
        "count_command": [
          "python3",
          "count_status.py",
          "searched"
        ]
      },
      {
        "name": "not_searched",
        "count_command": [
          "python3",
          "count_status.py",
          "not_searched"
        ]
      }
    ]
  },
  "executable_pass_condition": {
    "prepare_command": [
      "python3",
      "generate.py"
    ],
    "check_command": [
      "python3",
      "check.py"
    ],
    "generated_paths": [
      "results/result.json"
    ],
    "mutations": [
      {
        "name": "corrupt-generated-verdict",
        "path": "results/result.json",
        "search": "\"verdict\": \"PASS\"",
        "replace": "\"verdict\": \"FAIL\""
      }
    ]
  },
  "observation_surface": {
    "command": [
      "python3",
      "observe.py"
    ]
  },
  "final_artifact_binding": {
    "prepare_command": [
      "python3",
      "bind.py"
    ],
    "verify_command": [
      "python3",
      "verify_binding.py"
    ],
    "artifact_paths": [
      "results/result.json"
    ],
    "receipt_path": "results/binding.json"
  }
}
